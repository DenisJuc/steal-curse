{
  "name": "RelicCollector",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "DiscoveryResult": {
          "$className": "RemoteEvent"
        },
        "Notify": {
          "$className": "RemoteEvent"
        },
        "SignalsUpdated": {
          "$className": "RemoteEvent"
        },
        "BeginBind": {
          "$className": "RemoteEvent"
        },
        "CancelBind": {
          "$className": "RemoteEvent"
        },
        "CompleteBind": {
          "$className": "RemoteEvent"
        },
        "BindResult": {
          "$className": "RemoteEvent"
        },
        "SetRarityFocus": {
          "$className": "RemoteEvent"
        },
        "SetFrequency": {
          "$className": "RemoteEvent"
        },
        "ShrineAction": {
          "$className": "RemoteEvent"
        },
        "ShrineState": {
          "$className": "RemoteEvent"
        },
        "GetInventory": {
          "$className": "RemoteFunction"
        },
        "InventoryAction": {
          "$className": "RemoteFunction"
        },
        "GetCodex": {
          "$className": "RemoteFunction"
        },
        "ClaimCodex": {
          "$className": "RemoteFunction"
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$properties": {
        "LightingStyle": "Realistic"
      }
    },

    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
